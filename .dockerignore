# Build context is the repository root; see Dockerfile.

/.git/
/.github/
/site/
/test/
/schema/
/docs/

/web/.git/
/web/.bundle/
/web/.env*
/web/config/master.key
/web/config/credentials/*.key
/web/log/*
/web/tmp/*
!/web/log/.keep
!/web/tmp/.keep
!/web/tmp/pids/.keep
/web/storage/*
!/web/storage/.keep
/web/test/
/web/node_modules/
/web/app/assets/builds/*
!/web/app/assets/builds/.keep

*.md
!/README.md
