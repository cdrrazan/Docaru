# Copy to .env and fill in. Every value below should be generated, not chosen.
#
#   openssl rand -hex 64   # SECRET_KEY_BASE
#   openssl rand -hex 32   # each of the three encryption keys

# Signs cookies and sessions.
SECRET_KEY_BASE=

# Encrypt the document identifier and notes columns at rest.
#
# Losing these does not lose your deadlines — kind, country and expiry date are
# stored in the clear so the app can compute reminders without being able to
# read a passport number. It does lose the identifiers and notes themselves.
#
# These are unrelated to the vault passphrase, which encrypts scans in the
# browser and never reaches the server at all.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Database. The compose file starts a MySQL server using these; point
# DATABASE_HOST elsewhere if you already run one.
#
# Generate both passwords rather than choosing them:
#   openssl rand -hex 24
DATABASE_ROOT_PASSWORD=
DATABASE_PASSWORD=
DATABASE_USERNAME=docaru
DATABASE_NAME=docaru_production
# Left unset under compose, where it is supplied as the service name.
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306

# Public hostname, used for links in reminder emails. A relative link in an
# email goes nowhere.
APP_HOST=localhost:8080
PORT=8080

# Billing, via Paddle. Optional: without these the upgrade button does not
# appear, every household stays on the free plan, and alerts and playbooks work
# exactly as they always do — those are never paywalled.
#
# Paddle rather than Stripe because Stripe will not onboard a business based in
# Nepal. Paddle is a Merchant of Record: it is the seller, and it collects and
# remits VAT and sales tax in whichever country the buyer happens to be in.
#
# PADDLE_ENVIRONMENT defaults to "sandbox". Set it to "production" only when you
# mean to take real money — the default is the mistake that cannot charge
# anybody.
#
# One price per paid plan, and they should be annual prices — a vault is opened
# about three times a year, and billing monthly for that hands somebody twelve
# occasions a year to reconsider. Set only the ones you sell: a plan with no
# price configured is not offered, rather than offered and then failing at the
# checkout.
#
# PADDLE_PRICE_ID is the old single-price name and is still read as the
# household price, so an instance set up before the archive tier existed keeps
# working untouched.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_HOUSEHOLD=
PADDLE_PRICE_ID_ARCHIVE=

# Web Push. Optional: without these the app runs fine, the notification toggle
# does not appear, and reminders go by email alone. With them, a reminder also
# lands on the device — which is the difference between reading it today and
# reading it whenever somebody next opens their inbox.
#
# Generate the pair once and keep it. Changing it silently invalidates every
# subscription your users have already granted, and browsers will not re-prompt:
#
#   bin/rails runner 'k = WebPush.generate_key; puts k.public_key; puts k.private_key'
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Where a push service should complain if your messages misbehave. Must be a
# mailto: or https: URL; defaults to MAIL_FROM.
# VAPID_SUBJECT=mailto:reminders@example.com

# Outbound email. Without these the app runs fine and sends nothing — which
# means no reminders, which means it does not do the one thing it exists for.
# Configure them before relying on it.
MAIL_FROM=reminders@example.com
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USER_NAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
