# Copy to .env and fill in. Every value below should be generated, not chosen.
#
#   openssl rand -hex 64   # SECRET_KEY_BASE
#   openssl rand -hex 32   # each of the three encryption keys

# Signs cookies and sessions.
SECRET_KEY_BASE=

# Encrypt the document identifier and notes columns at rest.
#
# Losing these does not lose your deadlines — kind, country and expiry date are
# stored in the clear so the app can compute reminders without being able to
# read a passport number. It does lose the identifiers and notes themselves.
#
# These are unrelated to the vault passphrase, which encrypts scans in the
# browser and never reaches the server at all.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Database. The compose file starts a MySQL server using these; point
# DATABASE_HOST elsewhere if you already run one.
#
# Generate both passwords rather than choosing them:
#   openssl rand -hex 24
DATABASE_ROOT_PASSWORD=
DATABASE_PASSWORD=
DATABASE_USERNAME=renewaru
DATABASE_NAME=renewaru_production
# Left unset under compose, where it is supplied as the service name.
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306

# Public hostname, used for links in reminder emails. A relative link in an
# email goes nowhere.
APP_HOST=localhost:8080
PORT=8080

# Outbound email. Without these the app runs fine and sends nothing — which
# means no reminders, which means it does not do the one thing it exists for.
# Configure them before relying on it.
MAIL_FROM=reminders@example.com
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USER_NAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
