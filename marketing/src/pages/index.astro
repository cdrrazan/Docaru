---
import Base from "../layouts/Base.astro"
import Icon from "../components/Icon.astro"

const APP = import.meta.env.PUBLIC_APP_URL || "https://app.docaru.com"

// Written for the person, not the reviewer. The earlier version of this page
// explained the architecture; this one describes the afternoon somebody loses
// to a document in a cupboard in another country, and lets the architecture be
// the reason to believe it rather than the pitch.
const features = [
  {
    icon: "lock",
    title: "Nobody here can open them",
    body: "Your files are locked in your browser before they are uploaded, with a key we never receive. We hold the locked version and no way to unlock it — not for an employee, not for an advertiser, not for a court."
  },
  {
    icon: "people",
    title: "The whole family, one place",
    body: "Your mother's citizenship certificate, your brother's licence, your own degree. Everyone's papers in one vault, so finding one does not start with a phone call to somebody who is asleep."
  },
  {
    icon: "globe",
    title: "Reachable from anywhere",
    body: "A phone in Doha, a borrowed laptop in Manchester, a cybercafé in Kuala Lumpur. If you can open a browser, you can reach your documents."
  },
  {
    icon: "clock",
    title: "It knows what expires, and when to start",
    body: "Not \"your passport expires in March\" — that is a calendar reminder and it comes too late. It says start in November, because renewing from where you are takes ten weeks and needs a police certificate you have not ordered yet."
  },
  {
    icon: "server",
    title: "Run it on your own machine",
    body: "One container. No account with us, no monthly fee, no trust required at all. It is the stronger option and we would rather say so."
  },
  {
    icon: "card",
    title: "Free to start, and free to leave",
    body: "One person and a gigabyte, no card. Your files are yours: download them whenever you like, and nothing is held back if you stop paying."
  }
]

const faqs = [
  {
    q: "What happens if I forget my passphrase?",
    a: "You use the recovery code you were given when you set the vault up — it opens the same files and lets you choose a new passphrase. If you have lost both, your scans cannot be recovered by anyone, including us. That is the direct cost of nobody being able to read them, and any service offering you both a zero-knowledge promise and a password reset is quietly not doing one of them."
  },
  {
    q: "How is this different from Google Drive or iCloud?",
    a: "They can read your files. Not as an accusation — it is how the features work, because search, previews and automatic sorting all need the contents. We cannot, so we do not offer those. What you get instead is a guarantee that survives a subpoena, a data breach and a change of ownership."
  },
  {
    q: "Do I have to pay to get the renewal reminders?",
    a: "No. Reminders and renewal guides are free on every plan, forever, and they keep working even if a payment fails. Somebody whose card bounces while they are abroad is exactly the person most likely to need the alert."
  },
  {
    q: "Is my passport number encrypted too?",
    a: "Yes, along with your notes. The document type, issuing country and expiry date are stored readable, because the server has to do arithmetic on those dates to work out when to warn you. Everything you scan is encrypted before it leaves your device."
  },
  {
    q: "What if you go out of business?",
    a: "The whole thing is open source and you can run it yourself today. Your files are encrypted with your key, not ours, so a copy of the data without us is still a copy that works."
  },
  {
    q: "Which countries does this work for?",
    a: "Storing documents works for every country. The renewal timings currently cover Nepal, with guides for renewing from the UK, US, Australia and Qatar. Everything else is stored and searchable, just without a start-by date."
  }
]
---
<Base
  title="Docaru — your family's documents, safe and reachable"
  description="An encrypted vault for the documents you would never put in Google Drive — your passport, your certificates, your family's papers. Reachable from anywhere, and it tells you when the ones with deadlines need renewing."
  path="/"
>
  <section class="hero">
    <h1>Your family's documents, wherever you are.</h1>

    <p class="lede">
      Passports, certificates, deeds — locked in your browser so nobody else can open them, and
      there when you need them at 2am in another country.
    </p>

    <div class="actions">
      <a class="btn" href={`${APP}/registration/new`}>Create your vault — free</a>
      <a class="btn btn-quiet" href="/self-host">Or run it yourself</a>
    </div>

    <ul class="trust">
      <li><Icon name="check" size={16} />No card needed</li>
      <li><Icon name="check" size={16} />1 GB free, forever</li>
      <li><Icon name="check" size={16} />Open source</li>
      <li><Icon name="check" size={16} />We cannot read your files</li>
    </ul>
  </section>

  <div class="scenario">
    <p><strong>You are in Doha. The visa office wants your birth certificate by Thursday.</strong></p>
    <p>
      It is in a folder, in a cupboard, in Kathmandu. So you call home, and somebody goes looking,
      and photographs it badly, and sends it over WhatsApp — where it stays forever, in a chat, on a
      server you do not control. Then in April you find out the passport you were going to use
      expired while you were dealing with all this.
    </p>
    <p class="note" style="margin-top:1rem">Both of those are the same problem. This fixes both.</p>
  </div>

  <h2>What you get</h2>

  <div class="cards">
    {features.map((feature) => (
      <div class="card feature">
        <span class="icon"><Icon name={feature.icon} /></span>
        <div>
          <h3>{feature.title}</h3>
          <p class="note">{feature.body}</p>
        </div>
      </div>
    ))}
  </div>

  <h2>How it works</h2>

  <ol class="steps">
    <li>
      <div>
        <strong>Photograph the document</strong>
        <span class="note">Your phone camera is fine. It is resized and locked on your device before anything is sent.</span>
      </div>
    </li>
    <li>
      <div>
        <strong>Add who it belongs to, and when it expires</strong>
        <span class="note">Or leave the date blank — most documents never expire, and those just sit there waiting for the day you need them.</span>
      </div>
    </li>
    <li>
      <div>
        <strong>Forget about it</strong>
        <span class="note">Search by name or document when you need one. For anything with a deadline, we work out the date you have to start and tell you then.</span>
      </div>
    </li>
  </ol>

  <h2>Compared with a cloud drive</h2>

  <div class="scroll" tabindex="0">
    <table class="compare">
      <thead>
        <tr>
          <th>&nbsp;</th>
          <th>Docaru</th>
          <th>Google Drive, iCloud, Dropbox</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Can the company read your files?</td>
          <td class="yes">No</td>
          <td class="no">Yes</td>
        </tr>
        <tr>
          <td>Readable if their database leaks?</td>
          <td class="yes">No</td>
          <td class="no">Yes</td>
        </tr>
        <tr>
          <td>Knows a passport needs renewing</td>
          <td class="yes">Yes</td>
          <td class="no">No</td>
        </tr>
        <tr>
          <td>Shared with your household</td>
          <td class="yes">Yes</td>
          <td class="no">Folder sharing</td>
        </tr>
        <tr>
          <td>Search inside documents</td>
          <td class="no">No — we cannot read them</td>
          <td class="yes">Yes</td>
        </tr>
        <tr>
          <td>Run it on your own machine</td>
          <td class="yes">Yes, free</td>
          <td class="no">No</td>
        </tr>
      </tbody>
    </table>
  </div>

  <p class="note">
    The one row we lose is the honest cost of the rest.
    <a href="/security">Here is exactly how the encryption works</a>.
  </p>

  <h2>Questions people ask first</h2>

  <div class="faq">
    {faqs.map((faq) => (
      <details>
        <summary>{faq.q}</summary>
        <p>{faq.a}</p>
      </details>
    ))}
  </div>

  <section class="cta">
    <h2>Put the cupboard on the internet, safely.</h2>
    <p class="note">Free for one person and a gigabyte. Nothing to install, and nothing we can read.</p>
    <div class="actions">
      <a class="btn" href={`${APP}/registration/new`}>Create your vault</a>
      <a class="btn btn-quiet" href="/pricing">See pricing</a>
    </div>
    <ul class="trust">
      <li><Icon name="check" size={16} />Reminders are never paywalled</li>
    </ul>
  </section>
</Base>
