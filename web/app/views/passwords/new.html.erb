<% content_for :title, "Reset your password" %>

<h1>Forgot your password?</h1>

<p class="lede">We will email you a link to set a new one.</p>

<%= form_with url: passwords_path do |form| %>
  <div class="field">
    <%= form.label :email_address, "Email address" %>
    <%= form.email_field :email_address, required: true, autofocus: true,
          autocomplete: "username", value: params[:email_address] %>
  </div>

  <%= form.submit "Email reset instructions", class: "btn" %>
<% end %>

<p class="note"><%= link_to "Back to sign in", new_session_path %></p>
