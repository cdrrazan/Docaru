<% content_for :title, "Sign in" %>

<h1>Sign in</h1>

<%= form_with url: session_path do |form| %>
  <div class="field">
    <%= form.label :email_address, "Email address" %>
    <%= form.email_field :email_address, required: true, autofocus: true,
          autocomplete: "username", value: params[:email_address] %>
  </div>

  <div class="field">
    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
  </div>

  <%= form.submit "Sign in", class: "btn" %>
<% end %>

<p class="note">
  <%= link_to "Forgot your password?", new_password_path %>
  &middot;
  <%= link_to "Create an account", new_registration_path %>
</p>
