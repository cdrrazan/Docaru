<section
  data-controller="vault"
  data-vault-salt-value="<%= household.vault_salt! %>"
  data-vault-recovery-salt-value="<%= household.recovery_salt! %>"
  data-vault-initialised-value="<%= household.vault_initialised? %>"
  data-vault-wrapped-key-value="<%= household.wrapped_key %>"
  data-vault-wrapped-key-iv-value="<%= household.wrapped_key_iv %>"
  data-vault-recovery-wrapped-key-value="<%= household.recovery_wrapped_key %>"
  data-vault-recovery-wrapped-key-iv-value="<%= household.recovery_wrapped_key_iv %>"
  data-vault-key-url-value="<%= vault_key_path %>"
  data-vault-document-id-value="<%= document.id %>"
  data-vault-upload-url-value="<%= document_attachments_path(document) %>">

  <h2>Scans</h2>

  <p class="note">
    Encrypted in your browser before they are uploaded. We store the ciphertext and never hold the
    key, so we cannot open these — and neither can anyone who reaches our database.
  </p>

  <% document.attachments.ordered.each do |attachment| %>
    <div
      data-attachment-url="<%= document_attachment_path(document, attachment) %>"
      data-attachment-iv="<%= attachment.iv %>"
      data-attachment-content-type="<%= attachment.content_type %>"
      hidden></div>
  <% end %>

  <%# First run. Shown instead of the unlock prompt, because asking somebody for %>
  <%# a passphrase they have never set is how people conclude they have lost %>
  <%# access to something they have not yet created. %>
  <div data-vault-target="setup" hidden>
    <div class="banner">
      <strong>Set up your vault.</strong>
      Choose a passphrase. It is not your account password, and it is never sent to us — we store
      only files you have already encrypted with it.
    </div>

    <div class="field">
      <label for="vault-setup-passphrase">Vault passphrase</label>
      <p class="hint">At least 10 characters. Long beats complicated.</p>
      <input type="password" id="vault-setup-passphrase" autocomplete="new-password"
             data-vault-target="setupPassphrase">
    </div>

    <div class="field">
      <label for="vault-setup-confirm">Again</label>
      <p class="hint">A typo here would lock you out of your own files.</p>
      <input type="password" id="vault-setup-confirm" autocomplete="new-password"
             data-vault-target="setupConfirm" data-action="keydown.enter->vault#createVault">
    </div>

    <button class="btn" data-action="vault#createVault">Create the vault</button>
  </div>

  <div data-vault-target="locked">
    <div class="banner">
      <strong>Vault locked.</strong>
      Enter your vault passphrase to add or view scans. It is not your account password, it is never
      sent to us, and it unlocks only this tab.
    </div>

    <div class="field">
      <label for="vault-passphrase">Vault passphrase</label>
      <input type="password" id="vault-passphrase" autocomplete="off"
             data-vault-target="passphrase" data-action="keydown.enter->vault#unlock">
    </div>

    <button class="btn" data-action="vault#unlock">Unlock</button>

    <% if household.recovery_available? %>
      <p class="note">
        Lost it? <a href="#" data-action="vault#showRecovery">Use your recovery code</a>.
      </p>
    <% end %>
  </div>

  <%# Recovery does not reveal the passphrase — nobody, here or at this company, %>
  <%# knows it. It opens the vault key with the second wrapping and seals it %>
  <%# again under a new passphrase. The scans are never touched. %>
  <div data-vault-target="recovery" hidden>
    <div class="banner">
      <strong>Recover with your code.</strong>
      The code you were shown when the vault was created. It opens the same files and lets you
      choose a new passphrase.
    </div>

    <div class="field">
      <label for="vault-recovery-code">Recovery code</label>
      <p class="hint">Dashes and capitals do not matter.</p>
      <input type="text" id="vault-recovery-code" autocomplete="off" spellcheck="false"
             data-vault-target="recoveryInput">
    </div>

    <div class="field">
      <label for="vault-recovery-passphrase">New passphrase</label>
      <p class="hint">At least 10 characters.</p>
      <input type="password" id="vault-recovery-passphrase" autocomplete="new-password"
             data-vault-target="recoveryPassphrase" data-action="keydown.enter->vault#recover">
    </div>

    <button class="btn" data-action="vault#recover">Recover</button>
  </div>

  <%# Shown once, on the screen that generated it, and never rendered from the %>
  <%# server — the server does not have it. Reloading the page loses it, which %>
  <%# is why the wording is blunt rather than reassuring. %>
  <div class="banner banner-warn" data-vault-target="recoveryPanel" hidden>
    <p>
      <strong>Write this down now.</strong>
      It is the only way back in if you forget your passphrase. We do not have a copy, so we cannot
      show it to you again or send it to you.
    </p>
    <p><code data-vault-target="recoveryCode" style="font-size:1.1em;letter-spacing:.06em"></code></p>
    <p>
      <button class="btn btn-quiet" data-action="vault#copyRecoveryCode">Copy</button>
      <button class="btn btn-quiet" onclick="window.print(); return false">Print</button>
    </p>
  </div>

  <div data-vault-target="unlocked" hidden>
    <div class="field">
      <label for="vault-files">Add pages</label>
      <p class="hint">
        Images are resized and converted before encryption — a phone photo of a passport does not
        need to be twelve megabytes.
      </p>
      <input type="file" id="vault-files" multiple accept="image/*,application/pdf"
             data-vault-target="input" data-action="vault#upload">
    </div>

    <div class="cards" data-vault-target="gallery"></div>

    <p>
      <% if document.attachments.none? %>
        <span class="note">No pages yet.</span>
      <% end %>
      <button class="btn btn-quiet" data-action="vault#lock">Lock vault</button>
    </p>
  </div>

  <%# Every reply the vault gives — unlocked, wrong passphrase, upload finished %>
  <%# — is written here and nowhere else. Without a live region a screen reader %>
  <%# never learns whether the passphrase worked, on the one screen where %>
  <%# guessing wrong means silently uploading nothing. %>
  <p data-vault-target="status" class="note" role="status" aria-live="polite"></p>

  <noscript>
    <div class="banner banner-warn">
      Scans need JavaScript, because the encryption happens in your browser. Everything else on this
      page works without it.
    </div>
  </noscript>
</section>
