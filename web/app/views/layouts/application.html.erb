<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= social_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= social_description %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="canonical" href="<%= canonical_url %>">
    <%= yield :robots %>

    <%# Playbook links get pasted into forum threads and family chats. Without %>
    <%# these a shared link renders as a bare URL, which is the distribution %>
    <%# channel throwing itself away. %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Renewal playbooks">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:title" content="<%= social_title %>">
    <meta property="og:description" content="<%= social_description %>">
    <%# Served from public/, not the asset pipeline, so it is joined by hand — %>
    <%# image_url would look for a digested asset that does not exist. %>
    <meta property="og:image" content="<%= URI.join(root_url, "/icon.png") %>">
    <meta name="twitter:card" content="summary">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= tag.link rel: "manifest", href: pwa_manifest_path %>
    <%# Matches --accent and --bg, so the browser chrome does not sit against %>
    <%# the page in the wrong colour once installed. %>
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#1c5d4a">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#14140f">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="masthead">
      <div class="wrap">
        <a class="brand" href="<%= root_path %>">Renewal playbooks</a>
        <nav>
          <a href="<%= calculator_path %>">When to start</a>
          <a href="<%= playbooks_path %>">Playbooks</a>
          <a href="<%= plan_path %>">Pricing</a>
          <% if authenticated? %>
            <a href="<%= dashboard_path %>">Deadlines</a>
            <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-quiet",
                  form: { style: "display:inline" } %>
          <% else %>
            <a href="<%= new_session_path %>">Sign in</a>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <% flash.each do |type, message| %>
        <div class="flash <%= "flash-alert" if type.to_s == "alert" %>"><%= message %></div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="sitefoot">
      <div class="wrap">
        <p>
          Community-maintained reference information, not legal advice. Government processes change
          without notice — every playbook shows when it was last checked and links to the authority
          it came from.
        </p>
      </div>
    </footer>
  </body>
</html>
