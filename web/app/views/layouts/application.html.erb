<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Renewal playbooks" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || "Every document you own has a deadline. We tell you which one is next, and exactly what to do about it." %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="masthead">
      <div class="wrap">
        <a class="brand" href="<%= root_path %>">Renewal playbooks</a>
        <nav>
          <a href="<%= playbooks_path %>">Playbooks</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <% flash.each do |type, message| %>
        <div class="flash <%= "flash-alert" if type.to_s == "alert" %>"><%= message %></div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="sitefoot">
      <div class="wrap">
        <p>
          Community-maintained reference information, not legal advice. Government processes change
          without notice — every playbook shows when it was last checked and links to the authority
          it came from.
        </p>
      </div>
    </footer>
  </body>
</html>
