<% content_for :title, "Your household" %>

<h1>Your household</h1>

<% if @documents.empty? %>
  <p class="lede">
    Nothing stored yet. Put a document in — a certificate, a passport, a deed — and its scans are
    encrypted in your browser before they are uploaded. We hold ciphertext and never the key.
  </p>

  <p>
    <% if @members.any? %>
      <%= link_to "Add a document", new_document_path, class: "btn" %>
    <% else %>
      <%= link_to "Add a person", new_member_path, class: "btn" %>
    <% end %>
  </p>
<% else %>
  <%# The queue, and only the queue. A vault is mostly documents that want %>
  <%# nothing, and mixing those in here would teach people to skim past it. %>
  <% if @needs_attention.any? %>
    <% next_up = @needs_attention.first %>

    <section class="answer answer-warn">
      <p class="eyebrow">Needs you</p>
      <p class="headline"><%= next_up.title %></p>
      <p><%= document_verdict(next_up) %></p>
      <p class="note"><%= next_up.member.name %></p>
    </section>

    <% if @needs_attention.size > 1 %>
      <p class="note">
        <%= pluralize(@needs_attention.size, "document") %> need attention.
      </p>
    <% end %>
  <% else %>
    <section class="answer">
      <p class="eyebrow">Nothing to do</p>
      <p class="headline">No deadline needs you right now.</p>
      <p>
        <%= pluralize(@documents.size, "document") %> stored and
        <%= @watching.any? ? "#{pluralize(@watching.size, "deadline")} being watched" : "no deadlines to watch" %>.
      </p>
    </section>
  <% end %>

  <% @blocked.each do |document, chain| %>
    <% chain.blocking.each do |link| %>
      <div class="banner banner-warn">
        <strong><%= document.title %> is blocked by another document.</strong>
        <% if link.status == :expires_first %>
          <%= link_to link.document.title, document_path(link.document) %> expires
          <%= link.document.expires_on.strftime("%-d %B %Y") %>, before this renewal needs it.
          Renew that one first.
        <% else %>
          <%= link_to link.document.title, document_path(link.document) %> has to be renewed by
          <%= link.document.start_by.strftime("%-d %B %Y") %>, which comes first. Do them in that order.
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if (dated = @needs_attention + @watching).any? %>
    <section>
      <h2>Deadlines</h2>
      <div class="scroll" tabindex="0" role="region" aria-label="Documents with a deadline">
        <table>
          <caption class="visually-hidden">
            Every document with an expiry date, most urgent first.
          </caption>
          <thead>
            <tr>
              <th scope="col">Document</th>
              <th scope="col">Person</th>
              <th scope="col" class="num">Start by</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            <% dated.each do |document| %>
              <tr>
                <td><%= link_to document.title, document_path(document) %></td>
                <td class="note"><%= document.member.name %></td>
                <td class="num"><%= document.start_by&.strftime("%-d %b %Y") || "—" %></td>
                <td><%= status_tag(document) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <% if @stored.any? %>
    <section>
      <h2>Stored, nothing to watch</h2>
      <p class="note">
        These do not expire. They are here so you can reach them from anywhere —
        which is most of what a vault is for.
      </p>
      <ul class="docs">
        <% @stored.first(6).each do |document| %>
          <li>
            <%= link_to document.title, document_path(document) %>
            <span class="note">· <%= document.member.name %></span>
          </li>
        <% end %>
      </ul>
      <p><%= link_to "Browse all #{pluralize(@documents.size, "document")}", documents_path %></p>
    </section>
  <% end %>
<% end %>

<% if PushSubscription.configured? %>
  <section data-controller="push"
           data-push-public-key-value="<%= ENV["VAPID_PUBLIC_KEY"] %>"
           data-push-url-value="<%= push_subscription_path %>">
    <h2>Notifications on this device</h2>
    <p class="note">
      Reminders always go to <%= current_user.email_address %>. Turning this on adds a notification
      on this device, which is the difference between reading it today and reading it whenever you
      next open your email.
    </p>

    <p>
      <button type="button" class="btn" data-push-target="enable" data-action="push#enable" hidden>
        Turn on notifications
      </button>
      <button type="button" class="btn btn-quiet" data-push-target="disable" data-action="push#disable" hidden>
        Turn off on this device
      </button>
    </p>

    <p class="note" data-push-target="status" role="status" aria-live="polite"></p>
  </section>
<% end %>

<section>
  <h2>Household</h2>
  <p class="note">
    <%= household.name %> &middot; <%= pluralize(@members.size, "person") %> &middot;
    <%= pluralize(@documents.size, "document") %>
  </p>

  <%= render "shared/storage", household: household %>

  <p>
    <%= link_to "Browse the vault", documents_path %>
    &middot; <%= link_to "Manage people", members_path %>
    &middot; <%= link_to "Add a document", new_document_path %>
  </p>
</section>
